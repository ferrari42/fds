def linear_search(arr, key):
    for i in range(len(arr)):
        if arr[i] == key:
            return True
    return False

def sentinel_search(arr, key):
    n = len(arr)
    last = arr[-1]
    arr[-1] = key
    i = 0
    while arr[i] != key:
        i += 1
    arr[-1] = last
    if (i < n - 1) or (arr[-1] == key):
        return True
    return False

def binary_search(arr, key):
    low, high = 0, len(arr) - 1
    while low <= high:
        mid = (low + high) // 2
        if arr[mid] == key:
            return True
        elif arr[mid] < key:
            low = mid + 1
        else:
            high = mid - 1
    return False

def fibonacci_search(arr, key):
    n = len(arr)
    fibMMm2 = 0
    fibMMm1 = 1
    fibM = fibMMm2 + fibMMm1
    while fibM < n:
        fibMMm2 = fibMMm1
        fibMMm1 = fibM
        fibM = fibMMm2 + fibMMm1
    offset = -1
    while fibM > 1:
        i = min(offset + fibMMm2, n - 1)
        if arr[i] < key:
            fibM = fibMMm1
            fibMMm1 = fibMMm2
            fibMMm2 = fibM - fibMMm1
            offset = i
        elif arr[i] > key:
            fibM = fibMMm2
            fibMMm1 -= fibMMm2
            fibMMm2 = fibM - fibMMm1
        else:
            return True
    if fibMMm1 and offset + 1 < n and arr[offset + 1] == key:
        return True
    return False

rolls_unsorted = list(map(int, input("Enter roll numbers (unsorted): ").split()))
key = int(input("Enter roll number to search (unsorted): "))
print("Linear Search: Student attended training." if linear_search(rolls_unsorted, key) else "Linear Search: Student did NOT attend training.")
print("Sentinel Search: Student attended training." if sentinel_search(rolls_unsorted[:], key) else "Sentinel Search: Student did NOT attend training.")

