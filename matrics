# Input matrix
def get_matrix(name):
    print(f"Enter 2x2 matrix {name}:")
    mat = []
    for i in range(2):
        row = []
        for j in range(2):
            val = int(input(f"{name}[{i+1}][{j+1}]: "))
            row.append(val)
        mat.append(row)
    return mat

# Display matrix
def print_matrix(mat):
    for row in mat:
        print(row)

A = get_matrix("A")
B = get_matrix("B")

# Addition
add = [[A[i][j] + B[i][j] for j in range(2)] for i in range(2)]

# Subtraction
sub = [[A[i][j] - B[i][j] for j in range(2)] for i in range(2)]

# Multiplication
mul = [[0, 0], [0, 0]]
for i in range(2):
    for j in range(2):
        for k in range(2):
            mul[i][j] += A[i][k] * B[k][j]

# Transpose of A
trans = [[A[j][i] for j in range(2)] for i in range(2)]

print("\nAddition:")
print_matrix(add)

print("\nSubtraction:")
print_matrix(sub)

print("\nMultiplication:")
print_matrix(mul)

print("\nTranspose of A:")
print_matrix(trans)
